# Server settings for local runs. Copy to `.env` at the repository root and fill in the values.
# `AppConfigLoader` in `server/core-config` reads this file; a real environment variable of the same
# name always wins over the value here.

APP_ENV=development
PORT=8080

# The admin app sends this key with every admin API call. Staging and production need their own.
ADMIN_API_KEY=local-admin-key

DATABASE_URL=jdbc:postgresql://localhost:5432/yap
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_POOL_SIZE=10
DATABASE_RESET_ON_MIGRATION_CHANGE=false
