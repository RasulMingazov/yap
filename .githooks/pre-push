#!/bin/sh
# Blocks `git push` if Detekt finds violations. Enable once per clone with:
#   git config core.hooksPath .githooks

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root" || exit 1

echo "Running Detekt before push..."
if ! ./gradlew detekt --console=plain; then
    echo ""
    echo "Detekt found violations: push aborted."
    echo "Run './gradlew detekt' to see the findings, fix them, then push again."
    exit 1
fi
